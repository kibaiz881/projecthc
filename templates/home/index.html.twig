{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
<div class="example-wrapper">
    <h2>Photos récentes</h2>
    <div>
        <a href="{{ path('app_profiles') }}" class="btn btn-primary mb-3">Ajouter une photo</a>
    </div>
    <h1>Hello profiles users ✅</h1>
    This friendly message is coming from: Test
    <div>
    {% for profile in profiles %}
         <img src="{{ asset('./images/products/' ~ profile.imageName) }}" alt="Image du profil" style="max-width: 200px;">    
        <p>{{ profile.description }}</p>
    {% endfor %}
</div>
</div>

{% endblock %}
